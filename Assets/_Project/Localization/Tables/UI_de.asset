      m_Items: []
  - m_Id: 17778034151510021
    m_Localized: "\xDCberlebe {0} Sekunden in einer Runde"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510022
    m_Localized: Erreiche {0} Punkte in einer Runde
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510023
    m_Localized: "W\xE4hle {0} Perks"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510024
    m_Localized: Spiele {0} Runden
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510025
    m_Localized: Werbung / {0}
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510026
    m_Localized: Ziehe mit dem Finger, um deinen Planeten zu steuern
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510027
    m_Localized: "Roter Ring: gr\xF6\xDFerer Planet. Lauf weg!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510028
    m_Localized: "Gr\xFCner Ring: kleinerer Planet. Friss ihn!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510029
    m_Localized: "Wachse f\xFCr Monde und deinen ersten Perk"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441010253824
    m_Localized: Meteorschauer im Anflug
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448128
    m_Localized: Meteorschauer!
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448129
    m_Localized: Ein Stern erwacht
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448130
    m_Localized: Ein Stern explodiert gleich!
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448131
    m_Localized: Ein Schwarzes Loch entsteht
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448132
    m_Localized: Schwarzes Loch! Halte Abstand
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448133
    m_Localized: 'Heute: geringe Schwerkraft'
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448134
    m_Localized: 'Heute: hohe Schwerkraft'
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448135
    m_Localized: 'Heute: Goldrausch, mehr Beute'
    m_Metadata:
      m_Items: []
  - m_Id: 17797599656923136
    m_Localized: Joystick rechts
    m_Metadata:
      m_Items: []
  - m_Id: 18109183573741568
    m_Localized: Fester Joystick
    m_Metadata:
      m_Items: []
  - m_Id: 18134015178821632
    m_Localized: Schwierigkeit
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541888
    m_Localized: "Bots und Solo-Schaden; Raumhost w\xE4hlt"
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541889
    m_Localized: Leicht
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541890
    m_Localized: Mittel
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541891
    m_Localized: Schwer
    m_Metadata:
      m_Items: []
  - m_Id: 18145445231841280
    m_Localized: "Verbindung zum Spiel wird wiederhergestellt\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 18266357037051904
    m_Localized: Bei Play Spiele anmelden
    m_Metadata:
      m_Items: []
  - m_Id: 18266357120937984
    m_Localized: Bestenlisten
    m_Metadata:
      m_Items: []
  - m_Id: 18266357120937985
    m_Localized: Erfolge
    m_Metadata:
      m_Items: []
  - m_Id: 21402280072556544
    m_Localized: "Ausr\xFCsten"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802752
    m_Localized: "Ausger\xFCstet"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802753
    m_Localized: '{0} Sternenstaub'
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802754
    m_Localized: Per Werbung freischalten
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802755
    m_Localized: "T\xE4glicher Wechsel um {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802756
    m_Localized: "{0}/{1} \xB7 +{2} Sternenstaub"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802757
    m_Localized: Automatische Wahl
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802758
    m_Localized: Komet
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802759
    m_Localized: Mondtreffer
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802760
    m_Localized: Arenarand
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802761
    m_Localized: Ionenspur
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802762
    m_Localized: Schwarzes Loch
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802763
    m_Localized: "Tutorial \xFCberspringen"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802764
    m_Localized: "Friss kleinere Planeten. Meide gr\xF6\xDFere Planeten und ihre Monde."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802765
    m_Localized: Kometen sind schnell. Treffer kosten Masse. Weiche aus oder sammle Futter in ihrer Spur.
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802766
    m_Localized: "Ein Schwarzes Loch zieht Planeten an. Im Kern verlierst du Masse. Bleib au\xDFerhalb des Rings."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802767
    m_Localized: "Dein Planet hat sich entwickelt. Umlaufende Monde k\xF6nnen Gegner treffen. W\xE4hle einen Vorteil f\xFCr diese Runde."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802768
    m_Localized: "Du bist aufgestiegen. Partien bringen EP und jeder neue Rang gibt Sternenstaub. Gib ihn im Profil f\xFCr Planeten aus."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802769
    m_Localized: "Gr\xFCne Welt"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802770
