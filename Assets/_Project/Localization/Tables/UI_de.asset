    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: Aktualisiere das Spiel, um diesem Raum beizutreten
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: '{0} hat {1} gefressen'
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: Friss leuchtende Nahrung, um zu wachsen
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "Friss kleinere Planeten, flieh vor gr\xF6\xDFeren"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "Boost kostet Masse \u2013 nutze ihn zur Flucht oder Jagd"
    m_Metadata:
      m_Items: []
  - m_Id: 76559036448768
    m_Localized: Schnelles Spiel
    m_Metadata:
      m_Items: []
  - m_Id: 76559170666496
    m_Localized: Suche nach einem Spiel...
    m_Metadata:
      m_Items: []
