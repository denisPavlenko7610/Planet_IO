    m_Localized: Planet
    m_Metadata:
      m_Items: []
  - m_Id: 78881208664064
    m_Localized: Werbung
    m_Metadata:
      m_Items: []
  - m_Id: 16379358955941888
    m_Localized: "Datenschutzerkl\xE4rung"
    m_Metadata:
      m_Items: []
  - m_Id: 16380462645096448
    m_Localized: Kometennamen
    m_Metadata:
      m_Items: []
  - m_Id: 17755957282484224
    m_Localized: "Werbung nicht verf\xFCgbar. Bitte sp\xE4ter erneut versuchen."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241810624512
    m_Localized: "W\xE4hle einen Perk"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093504
    m_Localized: Ionenspur
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093505
    m_Localized: Boosttempo +15 %. Schadensspur bleibt 2 s. Massekosten des Boosts +25 %.
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093506
    m_Localized: "Magnetosph\xE4re"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093507
    m_Localized: Magnet +50%; Tempo -8%
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093508
    m_Localized: Schwere Monde
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093509
    m_Localized: +1 Mond; Schaden +50%; Tempo -5%
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093510
    m_Localized: Ablative Kruste
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093511
    m_Localized: "\xDCberlebe einen t\xF6dlichen Treffer mit 30 % der Masse vor dem Treffer, mindestens aber deiner Startmasse."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093512
    m_Localized: Sonnensegel
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093513
    m_Localized: Tempo +12%; Nahrung -10%
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093514
    m_Localized: Gravitationsbrunnen
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093515
    m_Localized: Gravitationszone +40%; Tempo -6%
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093516
    m_Localized: Nebelschleier
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093517
    m_Localized: 'Boost: 10 s von Karte weg; Abklingzeit 40 s'
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093518
    m_Localized: Kometenreiter
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093519
    m_Localized: "Kometentreffer heilen alle 5 s 20 % ihres \xFCblichen Schadens. Kein Aufprallschaden. Nat\xFCrliches Futter \u221210 %."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093520
    m_Localized: Raubtier
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093521
    m_Localized: Abschussmasse +20%; Nahrung -10%
    m_Metadata:
      m_Items: []
