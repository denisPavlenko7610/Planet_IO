    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u0435 \u0438\u0433\u0440\u0443, \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0439\u0442\u0438 \u0432 \u044D\u0442\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
