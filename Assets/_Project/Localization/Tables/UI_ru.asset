    m_Metadata:
      m_Items: []
  - m_Id: 3660316685
    m_Localized: "\u041A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0440\u0435\u043A\u043B\u0430\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316686
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316687
    m_Localized: "\u041E\u0434\u0438\u043D\u043E\u0447\u043D\u0430\u044F \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316688
    m_Localized: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316689
    m_Localized: "\u0418\u0433\u0440\u043E\u043A\u0438: {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316690
    m_Localized: "\u041C\u0435\u0441\u0442\u043E: #{0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316691
    m_Localized: "\u041B\u0438\u0434\u0435\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316692
    m_Localized: "\u0412\u0435\u0434\u0438\u0442\u0435 \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0434\u043B\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u2022 \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443 \u0434\u043B\u044F \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316693
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043C\u044B\u0448\u044C\u044E \u0438\u043B\u0438 WASD \u2022 \u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316694
    m_Localized: "\u0412\u044B \u0441\u044A\u0435\u043B\u0438 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316695
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510976
    m_Localized: "\u0421\u0447\u0451\u0442 {0}\n\u0420\u0435\u043A\u043E\u0440\u0434 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510977
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510978
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C (\u0440\u0435\u043A\u043B\u0430\u043C\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510979
    m_Localized: "\u041C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510980
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510981
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041D\u0430\u0437\u0430\u0434\xBB \u0435\u0449\u0451 \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3714642083840
    m_Localized: "\u0412\u0438\u0431\u0440\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 8989990191104
    m_Localized: "\u0425\u043E\u0441\u0442 \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385408
    m_Localized: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u0435 \u0438\u0433\u0440\u0443, \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0439\u0442\u0438 \u0432 \u044D\u0442\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: "{0} \u0441\u044A\u0435\u043B {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: "\u0415\u0448\u044C\u0442\u0435 \u0441\u0432\u0435\u0442\u044F\u0449\u0443\u044E\u0441\u044F \u0435\u0434\u0443, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "\u0415\u0448\u044C\u0442\u0435 \u043F\u043B\u0430\u043D\u0435\u0442\u044B \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435, \u0443\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u043E\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435 \u0442\u0440\u0430\u0442\u0438\u0442 \u043C\u0430\u0441\u0441\u0443 \u2014 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0435\u0433\u043E \u0434\u043B\u044F \u043F\u043E\u0431\u0435\u0433\u0430 \u0438\u043B\u0438 \u043E\u0445\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 76559036448768
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 76559170666496
    m_Localized: "\u041F\u043E\u0438\u0441\u043A \u0438\u0433\u0440\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 78881082834944
    m_Localized: "\u041F\u043B\u0430\u043D\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 78881208664064
    m_Localized: "\u0420\u0435\u043A\u043B\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 16379358955941888
    m_Localized: "\u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430 \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 16380462645096448
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043A\u043E\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 17755957282484224
    m_Localized: "\u0420\u0435\u043A\u043B\u0430\u043C\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241810624512
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0435\u0440\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093504
    m_Localized: "\u0418\u043E\u043D\u043D\u044B\u0439 \u0441\u043B\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093505
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0440\u0430\u043D\u044F\u0449\u0438\u0439 \u0441\u043B\u0435\u0434. \u0423\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435 \u0434\u043E\u0440\u043E\u0436\u0435 \u043D\u0430 25%."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093506
    m_Localized: "\u041C\u0430\u0433\u043D\u0438\u0442\u043E\u0441\u0444\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093507
    m_Localized: "\u041C\u0430\u0433\u043D\u0438\u0442 \u0435\u0434\u044B \u0434\u0430\u043B\u044C\u0448\u0435 \u043D\u0430 50%. \u0412\u044B \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435 \u043D\u0430 8%."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093508
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0435 \u043B\u0443\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093509
    m_Localized: "+1 \u043B\u0443\u043D\u0430 \u0438 +50% \u0443\u0440\u043E\u043D\u0430 \u043B\u0443\u043D. \u0412\u044B \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435 \u043D\u0430 5%."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093510
    m_Localized: "\u0410\u0431\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u0430\u044F \u043A\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093511
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0438\u0432\u0438\u0442\u0435 \u043E\u0434\u0438\u043D \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0443\u0434\u0430\u0440 \u0441 30% \u043C\u0430\u0441\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093512
    m_Localized: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u043F\u0430\u0440\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093513
    m_Localized: "\u0412\u044B \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043D\u0430 12%. \u0415\u0434\u0430 \u0434\u0430\u0451\u0442 \u043D\u0430 10% \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093514
    m_Localized: "\u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093515
    m_Localized: "\u0417\u043E\u043D\u0430 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438 \u0448\u0438\u0440\u0435 \u043D\u0430 40%. \u0412\u044B \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435 \u043D\u0430 6%."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093516
    m_Localized: "\u041F\u043E\u043A\u0440\u043E\u0432 \u0442\u0443\u043C\u0430\u043D\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093517
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F \u0432\u044B \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0435\u0442\u0435 \u0441 \u043C\u0438\u043D\u0438\u043A\u0430\u0440\u0442 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432 \u043D\u0430 10 \u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093518
    m_Localized: "\u041D\u0430\u0435\u0437\u0434\u043D\u0438\u043A \u043A\u043E\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093519
    m_Localized: "\u041A\u043E\u043C\u0435\u0442\u044B \u043B\u0435\u0447\u0430\u0442 \u0432\u0430\u0441, \u0430 \u043D\u0435 \u0440\u0430\u043D\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093520
    m_Localized: "\u0425\u0438\u0449\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093521
    m_Localized: "\u0423\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0434\u0430\u044E\u0442 \u043D\u0430 20% \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u0430\u0441\u0441\u044B. \u0415\u0434\u0430 \u0434\u0430\u0451\u0442 \u043D\u0430 10% \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
