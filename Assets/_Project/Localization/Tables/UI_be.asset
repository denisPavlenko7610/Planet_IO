      m_Items: []
  - m_Id: 3660316695
    m_Localized: "\u0412\u044B \u043F\u0440\u0430\u0439\u0433\u0440\u0430\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510976
    m_Localized: "\u041B\u0456\u043A {0}\n\u0420\u044D\u043A\u043E\u0440\u0434 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510977
    m_Localized: "\u0413\u0443\u043B\u044F\u0446\u044C \u0437\u043D\u043E\u045E"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510978
    m_Localized: "\u041F\u0440\u0430\u0446\u044F\u0433\u043D\u0443\u0446\u044C (\u0440\u044D\u043A\u043B\u0430\u043C\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510979
    m_Localized: "\u041C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510980
    m_Localized: "\u041F\u0430\u0441\u043A\u0430\u0440\u044D\u043D\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510981
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 \xAB\u041D\u0430\u0437\u0430\u0434\xBB \u044F\u0448\u0447\u044D \u0440\u0430\u0437, \u043A\u0430\u0431 \u0432\u044B\u0439\u0441\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 3714642083840
    m_Localized: "\u0412\u0456\u0431\u0440\u0430\u0446\u044B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 8989990191104
    m_Localized: "\u0425\u043E\u0441\u0442 \u043F\u0430\u043A\u0456\u043D\u0443\u045E \u0433\u0443\u043B\u044C\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385408
    m_Localized: "\u041F\u0430\u043A\u043E\u0439 \u0437\u0430\u043F\u043E\u045E\u043D\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: "\u0410\u0431\u043D\u0430\u0432\u0456\u0446\u0435 \u0433\u0443\u043B\u044C\u043D\u044E, \u043A\u0430\u0431 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045E \u0433\u044D\u0442\u044B \u043F\u0430\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: "{0} \u0437\u2019\u0435\u045E {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: "\u0415\u0448\u0446\u0435 \u0437\u0437\u044F\u044E\u0447\u0443\u044E \u0435\u0436\u0443, \u043A\u0430\u0431 \u0440\u0430\u0441\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "\u0415\u0448\u0446\u0435 \u043C\u0435\u043D\u0448\u044B\u044F \u043F\u043B\u0430\u043D\u0435\u0442\u044B, \u0443\u0446\u044F\u043A\u0430\u0439\u0446\u0435 \u0430\u0434 \u0431\u043E\u043B\u044C\u0448\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "\u041F\u0430\u0441\u043A\u0430\u0440\u044D\u043D\u043D\u0435 \u0442\u0440\u0430\u0446\u0456\u0446\u044C \u043C\u0430\u0441\u0443 \u2014 \u0432\u044B\u043A\u0430\u0440\u044B\u0441\u0442\u043E\u045E\u0432\u0430\u0439\u0446\u0435 \u044F\u0433\u043E \u0434\u043B\u044F \u045E\u0446\u0451\u043A\u0430\u045E \u0430\u0431\u043E \u043F\u0430\u043B\u044F\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 76559036448768
    m_Localized: "\u0425\u0443\u0442\u043A\u0430\u044F \u0433\u0443\u043B\u044C\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 76559170666496
    m_Localized: "\u041F\u043E\u0448\u0443\u043A \u0433\u0443\u043B\u044C\u043D\u0456..."
    m_Metadata:
      m_Items: []
  - m_Id: 78881082834944
    m_Localized: "\u041F\u043B\u0430\u043D\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 78881208664064
    m_Localized: "\u0420\u044D\u043A\u043B\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 16379358955941888
    m_Localized: "\u041F\u0430\u043B\u0456\u0442\u044B\u043A\u0430 \u043F\u0440\u044B\u0432\u0430\u0442\u043D\u0430\u0441\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 16380462645096448
    m_Localized: "\u041D\u0430\u0437\u0432\u044B \u043A\u0430\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 17755957282484224
    m_Localized: "\u0420\u044D\u043A\u043B\u0430\u043C\u0430 \u043D\u0435\u0434\u0430\u0441\u0442\u0443\u043F\u043D\u0430\u044F. \u041F\u0430\u0441\u043F\u0440\u0430\u0431\u0443\u0439\u0446\u0435 \u043F\u0430\u0437\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241810624512
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u044B\u0446\u0435 \u043F\u0435\u0440\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093504
    m_Localized: "\u0406\u043E\u043D\u043D\u044B \u0441\u043B\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093505
    m_Localized: "\u0411\u0443\u0441\u0442 +15%; \u0441\u043B\u0435\u0434 2 \u0441; \u0440\u0430\u0441\u0445\u043E\u0434 +25%"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093506
    m_Localized: "\u041C\u0430\u0433\u043D\u0456\u0442\u0430\u0441\u0444\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093507
    m_Localized: "\u041C\u0430\u0433\u043D\u0456\u0442 +50%; \u0445\u0443\u0442\u043A\u0430\u0441\u0446\u044C -8%"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093508
    m_Localized: "\u0426\u044F\u0436\u043A\u0456\u044F \u043C\u0435\u0441\u044F\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093509
    m_Localized: "+1 \u043C\u0435\u0441\u044F\u0446; \u0443\u0440\u043E\u043D +50%; \u0445\u0443\u0442\u043A\u0430\u0441\u0446\u044C -5%"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093510
    m_Localized: "\u0410\u0431\u043B\u044F\u0446\u044B\u0439\u043D\u0430\u044F \u043A\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093511
    m_Localized: "\u0412\u044B\u0440\u0430\u0442\u0430\u0432\u0430\u043D\u043D\u0435 1 \u0440\u0430\u0437; \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 30% \u043C\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093512
    m_Localized: "\u0421\u043E\u043D\u0435\u0447\u043D\u044B \u0432\u0435\u0442\u0440\u0430\u0437\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093513
    m_Localized: "\u0425\u0443\u0442\u043A\u0430\u0441\u0446\u044C +12%; \u0435\u0436\u0430 -10%"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093514
    m_Localized: "\u0413\u0440\u0430\u0432\u0456\u0442\u0430\u0446\u044B\u0439\u043D\u0430\u044F \u0441\u0442\u0443\u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093515
    m_Localized: "\u0417\u043E\u043D\u0430 \u0433\u0440\u0430\u0432\u0456\u0442\u0430\u0446\u044B\u0456 +40%; \u0445\u0443\u0442\u043A\u0430\u0441\u0446\u044C -6%"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093516
    m_Localized: "\u041F\u043E\u043A\u0440\u044B\u0432\u0430 \u0442\u0443\u043C\u0430\u043D\u043D\u0430\u0441\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093517
    m_Localized: "\u0411\u0443\u0441\u0442: \u0441\u0445\u0430\u0432\u0430\u043D\u044B \u0437 \u043A\u0430\u0440\u0442\u044B 10 \u0441; \u0430\u0434\u043A\u0430\u0442 40 \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093518
    m_Localized: "\u041D\u0430\u0435\u0437\u043D\u0456\u043A \u043A\u0430\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093519
    m_Localized: "\u041A\u0430\u043C\u0435\u0442\u044B \u043B\u0435\u0447\u0430\u0446\u044C \u043D\u0430 20% \u0443\u0440\u043E\u043D\u0443; \u0435\u0436\u0430 -10%"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093520
    m_Localized: "\u0414\u0440\u0430\u043F\u0435\u0436\u043D\u0456\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093521
    m_Localized: "\u041C\u0430\u0441\u0430 \u0437\u0430 \u0437\u0430\u0431\u043E\u0439\u0441\u0442\u0432\u044B +20%; \u0435\u0436\u0430 -10%"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034084401152
    m_Localized: "\u0427\u0430\u0441: {0}   \u0417\u2019\u0435\u0434\u0437\u0435\u043D\u0430: {1}   \u0423\u0437\u0440\u043E\u0432\u0435\u043D\u044C: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315712
    m_Localized: "\u0412\u0430\u0441 \u0437\u2019\u0435\u045E {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315713
    m_Localized: "\u0420\u0430\u043D\u0433 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315714
    m_Localized: "+{0} \u0434\u043E\u0441\u0432\u0435\u0434\u0443   +{1} \u0437\u043E\u0440\u043D\u0430\u0433\u0430 \u043F\u044B\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315715
    m_Localized: "\u041D\u043E\u0432\u044B \u0440\u0430\u043D\u0433!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315716
    m_Localized: "\u0417\u043E\u0440\u043D\u044B \u043F\u044B\u043B \xD72 (\u0440\u044D\u043A\u043B\u0430\u043C\u0430)"
    m_Metadata:
