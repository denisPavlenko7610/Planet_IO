  - m_Id: 3660316690
    m_Localized: "\u041C\u0435\u0441\u0446\u0430: #{0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316691
    m_Localized: "\u041B\u0456\u0434\u0430\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316692
    m_Localized: "\u0412\u044F\u0434\u0437\u0456\u0446\u0435 \u043F\u0430\u043B\u044C\u0446\u0430\u043C \u0434\u043B\u044F \u043A\u0456\u0440\u0430\u0432\u0430\u043D\u043D\u044F \u2022 \u0423\u0442\u0440\u044B\u043C\u043B\u0456\u0432\u0430\u0439\u0446\u0435 \u043A\u043D\u043E\u043F\u043A\u0443 \u0434\u043B\u044F \u043F\u0430\u0441\u043A\u0430\u0440\u044D\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316693
    m_Localized: "\u041A\u0456\u0440\u0430\u0432\u0430\u043D\u043D\u0435 \u043C\u044B\u0448\u0448\u0443 \u0430\u0431\u043E WASD \u2022 \u041F\u0440\u0430\u0431\u0435\u043B \u2014 \u043F\u0430\u0441\u043A\u0430\u0440\u044D\u043D\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316694
    m_Localized: "\u0412\u044B \u0437\u2019\u0435\u043B\u0456 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316695
    m_Localized: "\u0412\u044B \u043F\u0440\u0430\u0439\u0433\u0440\u0430\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510976
    m_Localized: "\u041B\u0456\u043A {0}\n\u0420\u044D\u043A\u043E\u0440\u0434 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510977
    m_Localized: "\u0413\u0443\u043B\u044F\u0446\u044C \u0437\u043D\u043E\u045E"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510978
    m_Localized: "\u041F\u0440\u0430\u0446\u044F\u0433\u043D\u0443\u0446\u044C (\u0440\u044D\u043A\u043B\u0430\u043C\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510979
    m_Localized: "\u041C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510980
    m_Localized: "\u041F\u0430\u0441\u043A\u0430\u0440\u044D\u043D\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510981
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 \xAB\u041D\u0430\u0437\u0430\u0434\xBB \u044F\u0448\u0447\u044D \u0440\u0430\u0437, \u043A\u0430\u0431 \u0432\u044B\u0439\u0441\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 3714642083840
    m_Localized: "\u0412\u0456\u0431\u0440\u0430\u0446\u044B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 8989990191104
    m_Localized: "\u0425\u043E\u0441\u0442 \u043F\u0430\u043A\u0456\u043D\u0443\u045E \u0433\u0443\u043B\u044C\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385408
    m_Localized: "\u041F\u0430\u043A\u043E\u0439 \u0437\u0430\u043F\u043E\u045E\u043D\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: "\u0410\u0431\u043D\u0430\u0432\u0456\u0446\u0435 \u0433\u0443\u043B\u044C\u043D\u044E, \u043A\u0430\u0431 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045E \u0433\u044D\u0442\u044B \u043F\u0430\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: "{0} \u0437\u2019\u0435\u045E {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: "\u0415\u0448\u0446\u0435 \u0437\u0437\u044F\u044E\u0447\u0443\u044E \u0435\u0436\u0443, \u043A\u0430\u0431 \u0440\u0430\u0441\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "\u0415\u0448\u0446\u0435 \u043C\u0435\u043D\u0448\u044B\u044F \u043F\u043B\u0430\u043D\u0435\u0442\u044B, \u0443\u0446\u044F\u043A\u0430\u0439\u0446\u0435 \u0430\u0434 \u0431\u043E\u043B\u044C\u0448\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "\u041F\u0430\u0441\u043A\u0430\u0440\u044D\u043D\u043D\u0435 \u0442\u0440\u0430\u0446\u0456\u0446\u044C \u043C\u0430\u0441\u0443 \u2014 \u0432\u044B\u043A\u0430\u0440\u044B\u0441\u0442\u043E\u045E\u0432\u0430\u0439\u0446\u0435 \u044F\u0433\u043E \u0434\u043B\u044F \u045E\u0446\u0451\u043A\u0430\u045E \u0430\u0431\u043E \u043F\u0430\u043B\u044F\u0432\u0430\u043D\u043D\u044F"
