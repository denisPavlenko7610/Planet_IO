      m_Items: []
  - m_Id: 17778034151510017
    m_Localized: "Changer (pub)"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510018
    m_Localized: "Termin\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510019
    m_Localized: "Mange {0} plan\xE8tes"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510020
    m_Localized: Atteins le palier {0}
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510021
    m_Localized: Survis {0} secondes en une partie
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510022
    m_Localized: Atteins {0} points en une partie
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510023
    m_Localized: Choisis {0} atouts
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510024
    m_Localized: Joue {0} parties
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510025
    m_Localized: Pub / {0}
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510026
    m_Localized: "Fais glisser ton doigt pour diriger ta plan\xE8te"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510027
    m_Localized: "Anneau rouge : plan\xE8te plus grosse. Fuis !"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510028
    m_Localized: "Anneau vert : plan\xE8te plus petite. Mange-la !"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510029
    m_Localized: Grandis pour obtenir des lunes et ton premier atout
    m_Metadata:
      m_Items: []
  - m_Id: 17782441010253824
    m_Localized: "Pluie de m\xE9t\xE9ores imminente"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448128
    m_Localized: "Pluie de m\xE9t\xE9ores !"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448129
    m_Localized: "Une \xE9toile se r\xE9veille"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448130
    m_Localized: "Une \xE9toile va exploser !"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448131
    m_Localized: Un trou noir se forme
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448132
    m_Localized: Trou noir ! Garde tes distances
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448133
    m_Localized: "Aujourd'hui : faible gravit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448134
    m_Localized: "Aujourd'hui : forte gravit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448135
    m_Localized: "Aujourd'hui : ru\xE9e vers l'or, butin plus riche"
    m_Metadata:
      m_Items: []
  - m_Id: 17797599656923136
    m_Localized: "Joystick \xE0 droite"
    m_Metadata:
      m_Items: []
  - m_Id: 18109183573741568
    m_Localized: Joystick fixe
    m_Metadata:
      m_Items: []
  - m_Id: 18134015178821632
    m_Localized: "Difficult\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541888
    m_Localized: "Bots et d\xE9g\xE2ts solo ; choix de l'h\xF4te"
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541889
    m_Localized: Facile
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541890
    m_Localized: Moyenne
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541891
    m_Localized: Difficile
    m_Metadata:
      m_Items: []
  - m_Id: 18266357037051904
    m_Localized: "Connexion \xE0 Play Jeux"
    m_Metadata:
      m_Items: []
  - m_Id: 18266357120937984
    m_Localized: Classements
    m_Metadata:
      m_Items: []
  - m_Id: 18266357120937985
    m_Localized: "Succ\xE8s"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280072556544
    m_Localized: "\xC9quiper"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802752
    m_Localized: "\xC9quip\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802753
    m_Localized: "{0} de poussi\xE8re d\u2019\xE9toiles"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802754
    m_Localized: "D\xE9bloquer avec une pub"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802755
    m_Localized: "Renouvellement \xE0 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802756
    m_Localized: "{0}/{1} \xB7 +{2} de poussi\xE8re d\u2019\xE9toiles"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802757
    m_Localized: Choix auto
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802758
    m_Localized: "Com\xE8te"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802759
    m_Localized: "Choc d\u2019une lune"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802760
    m_Localized: "Bord de l\u2019ar\xE8ne"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802761
    m_Localized: "Tra\xEEn\xE9e ionique"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802762
    m_Localized: Trou noir
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802763
    m_Localized: Passer le tutoriel
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802764
    m_Localized: "D\xE9vore les plan\xE8tes plus petites que la tienne. \xC9vite les plus grandes et leurs lunes."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802765
    m_Localized: "Les com\xE8tes sont rapides. Un choc te fait perdre de la masse. \xC9vite-les ou suis leur tra\xEEn\xE9e pour te nourrir."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802766
    m_Localized: "Un trou noir attire les plan\xE8tes. Son c\u0153ur fait perdre de la masse. Reste hors de l\u2019anneau."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802767
    m_Localized: "Ta plan\xE8te a \xE9volu\xE9. Les lunes en orbite peuvent frapper tes rivales. Choisis un atout pour cette partie."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802768
    m_Localized: "Tu as gagn\xE9 un rang. Les parties donnent de l\u2019XP et chaque rang rapporte de la poussi\xE8re d\u2019\xE9toiles. D\xE9pense-la pour des plan\xE8tes dans ton profil."
    m_Metadata:
      m_Items: []
