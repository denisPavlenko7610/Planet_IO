    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315720
    m_Localized: "S\xE9rie : {0} jours"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315721
    m_Localized: "Bonus du jour : +{0} poussi\xE8re d'\xE9toiles"
