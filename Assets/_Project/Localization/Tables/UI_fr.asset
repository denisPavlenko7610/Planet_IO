    m_Metadata:
      m_Items: []
  - m_Id: 8989990191104
    m_Localized: "L'h\xF4te a quitt\xE9 la partie"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385408
    m_Localized: La salle est pleine
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: "Mettez le jeu \xE0 jour pour rejoindre cette salle"
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: "{0} a mang\xE9 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: Mangez la nourriture lumineuse pour grandir
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "Mangez les plan\xE8tes plus petites, fuyez les plus grandes"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "Le boost co\xFBte de la masse \u2014 utilisez-le pour fuir ou chasser"
    m_Metadata:
      m_Items: []
  - m_Id: 76559036448768
    m_Localized: Partie rapide
    m_Metadata:
      m_Items: []
  - m_Id: 76559170666496
    m_Localized: Recherche d'une partie...
    m_Metadata:
      m_Items: []
  - m_Id: 78881082834944
    m_Localized: "Plan\xE8te"
    m_Metadata:
      m_Items: []
  - m_Id: 78881208664064
    m_Localized: Pub
    m_Metadata:
      m_Items: []
  - m_Id: 16379358955941888
    m_Localized: "Politique de confidentialit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 16380462645096448
    m_Localized: "Noms des com\xE8tes"
    m_Metadata:
      m_Items: []
  - m_Id: 17755957282484224
    m_Localized: "Publicit\xE9 indisponible. R\xE9essayez plus tard."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241810624512
    m_Localized: Choisis un atout
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093504
    m_Localized: "Tra\xEEn\xE9e ionique"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093505
    m_Localized: "Vitesse du boost +15 %. Tra\xEEn\xE9e dangereuse pendant 2 s. Co\xFBt en masse du boost +25 %."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093506
    m_Localized: "Magn\xE9tosph\xE8re"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093507
    m_Localized: "Rayon d\u2019attraction +50 %. Vitesse \u22128 %."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093508
    m_Localized: Lunes lourdes
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093509
    m_Localized: "+1 lune. D\xE9g\xE2ts des lunes +50 %. Vitesse \u22125 %."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093510
    m_Localized: "Cro\xFBte ablative"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093511
    m_Localized: "Survis \xE0 un coup fatal avec 30 % de ta masse avant le choc, au minimum ta masse de d\xE9part."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093512
    m_Localized: Voile solaire
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093513
    m_Localized: "Vitesse +12 %. Masse gagn\xE9e avec la nourriture naturelle \u221210 %."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093514
    m_Localized: Puits gravitationnel
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093515
    m_Localized: "Zone gravit\xE9 +40 % ; vitesse -6 %"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093516
    m_Localized: "Voile de n\xE9buleuse"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093517
    m_Localized: 'Le boost te masque sur la minicarte pendant 10 s. Recharge : 40 s.'
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093518
    m_Localized: "Chevaucheur de com\xE8tes"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093519
    m_Localized: "Un choc de com\xE8te rend 20 % de ses d\xE9g\xE2ts habituels toutes les 5 s. Chocs sans d\xE9g\xE2ts. Nourriture naturelle \u221210 %."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093520
    m_Localized: "Pr\xE9dateur"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093521
    m_Localized: "Masse gagn\xE9e en d\xE9vorant des plan\xE8tes +20 %. Masse tir\xE9e de la nourriture naturelle \u221210 %."
    m_Metadata:
      m_Items: []
