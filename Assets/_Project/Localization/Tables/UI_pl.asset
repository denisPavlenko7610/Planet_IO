    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510026
    m_Localized: "Przeci\u0105gnij palcem, aby sterowa\u0107 planet\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510027
    m_Localized: "Czerwony pier\u015Bcie\u0144: wi\u0119ksza planeta. Uciekaj!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510028
    m_Localized: "Zielony pier\u015Bcie\u0144: mniejsza planeta. Zjedz j\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510029
    m_Localized: "Ro\u015Bnij, by zdoby\u0107 ksi\u0119\u017Cyce i pierwsze ulepszenie"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441010253824
    m_Localized: "Nadci\u0105ga deszcz meteor\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448128
    m_Localized: "Deszcz meteor\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448129
    m_Localized: "Gwiazda si\u0119 budzi"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448130
    m_Localized: Gwiazda zaraz wybuchnie!
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448131
    m_Localized: Powstaje czarna dziura
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448132
