    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448133
    m_Localized: "Dzi\u015B: niska grawitacja"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448134
    m_Localized: "Dzi\u015B: wysoka grawitacja"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448135
    m_Localized: "Dzi\u015B: gor\u0105czka z\u0142ota, wi\u0119cej \u0142up\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448136
    m_Localized: 'Blitz: mecz na 5 minut'
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448137
