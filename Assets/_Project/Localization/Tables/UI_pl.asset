    m_Localized: "Osi\u0105gnij poziom {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510021
    m_Localized: Przetrwaj {0} s w jednej grze
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510022
    m_Localized: "Zdob\u0105d\u017A {0} pkt w jednej grze"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510023
    m_Localized: "Wybierz ulepsze\u0144: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510024
    m_Localized: Zagraj {0} gier
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510025
