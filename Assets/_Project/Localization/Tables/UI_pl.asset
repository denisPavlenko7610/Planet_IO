  - m_Id: 3660316672
    m_Localized: Gotowy do gry
    m_Metadata:
      m_Items: []
  - m_Id: 3660316673
    m_Localized: Tworzenie pokoju...
    m_Metadata:
      m_Items: []
  - m_Id: 3660316674
    m_Localized: "Pok\xF3j utworzony. Kod: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316675
    m_Localized: "\u0141\u0105czenie z pokojem {0}..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316676
    m_Localized: Uruchamianie gry...
    m_Metadata:
      m_Items: []
  - m_Id: 3660316677
    m_Localized: "\u0141adowanie..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316678
    m_Localized: Wychodzenie...
    m_Metadata:
      m_Items: []
  - m_Id: 3660316679
    m_Localized: "Nie uda\u0142o si\u0119 po\u0142\u0105czy\u0107. Sprawd\u017A kod pokoju i internet."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316680
    m_Localized: Wpisz kod pokoju
    m_Metadata:
      m_Items: []
  - m_Id: 3660316681
    m_Localized: Ustawienia
    m_Metadata:
      m_Items: []
  - m_Id: 3660316682
    m_Localized: Muzyka
    m_Metadata:
      m_Items: []
  - m_Id: 3660316683
    m_Localized: "Efekty d\u017Awi\u0119kowe"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316684
    m_Localized: "J\u0119zyk"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316685
    m_Localized: "Prywatno\u015B\u0107 reklam"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316686
    m_Localized: Zamknij
    m_Metadata:
      m_Items: []
  - m_Id: 3660316687
    m_Localized: Gra solo
    m_Metadata:
      m_Items: []
  - m_Id: 3660316688
    m_Localized: "Pok\xF3j {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316689
    m_Localized: 'Gracze: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 3660316690
    m_Localized: 'Miejsce: #{0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 3660316691
    m_Localized: Liderzy
    m_Metadata:
      m_Items: []
  - m_Id: 3660316692
    m_Localized: "Przeci\u0105gnij, by sterowa\u0107 \u2022 Przytrzymaj przycisk, by przyspieszy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316693
    m_Localized: "Steruj mysz\u0105 lub WASD \u2022 Przytrzymaj Spacj\u0119, by przyspieszy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316694
    m_Localized: 'Zjadasz: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 3660316695
    m_Localized: Przegrana
    m_Metadata:
      m_Items: []
  - m_Id: 3664510976
    m_Localized: 'Wynik {0}

      Rekord {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 3664510977
    m_Localized: Zagraj ponownie
    m_Metadata:
      m_Items: []
  - m_Id: 3664510978
    m_Localized: Kontynuuj (reklama)
    m_Metadata:
      m_Items: []
  - m_Id: 3664510979
    m_Localized: Menu
    m_Metadata:
      m_Items: []
  - m_Id: 3664510980
    m_Localized: Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 3664510981
    m_Localized: "Naci\u015Bnij Wstecz ponownie, aby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 3714642083840
    m_Localized: Wibracje
    m_Metadata:
      m_Items: []
  - m_Id: 8989990191104
    m_Localized: "Gospodarz opu\u015Bci\u0142 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385408
    m_Localized: "Pok\xF3j jest pe\u0142ny"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: "Zaktualizuj gr\u0119, aby do\u0142\u0105czy\u0107 do tego pokoju"
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: '{0} zjada: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: "Jedz \u015Bwiec\u0105ce jedzenie, aby rosn\u0105\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "Zjadaj mniejsze planety, uciekaj przed wi\u0119kszymi"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "Turbo zu\u017Cywa mas\u0119 \u2014 u\u017Cywaj go do ucieczki lub polowania"
    m_Metadata:
      m_Items: []
  - m_Id: 76559036448768
    m_Localized: Szybka gra
    m_Metadata:
      m_Items: []
  - m_Id: 76559170666496
    m_Localized: Szukanie gry...
    m_Metadata:
      m_Items: []
  - m_Id: 78881082834944
    m_Localized: Planeta
    m_Metadata:
      m_Items: []
  - m_Id: 78881208664064
    m_Localized: Reklama
    m_Metadata:
      m_Items: []
  - m_Id: 16379358955941888
    m_Localized: "Polityka prywatno\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 16380462645096448
    m_Localized: Nazwy komet
    m_Metadata:
      m_Items: []
  - m_Id: 17755957282484224
    m_Localized: "Reklama niedost\u0119pna. Spr\xF3buj ponownie p\xF3\u017Aniej."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241810624512
    m_Localized: Wybierz ulepszenie
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093504
    m_Localized: "Jonowy \u015Blad"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093505
    m_Localized: "Turbo zostawia szkodliwy \u015Blad. Turbo kosztuje o 25% wi\u0119cej."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093506
    m_Localized: Magnetosfera
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093507
    m_Localized: "Magnes jedzenia si\u0119ga o 50% dalej. Jeste\u015B o 8% wolniejszy."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093508
    m_Localized: "Ci\u0119\u017Ckie ksi\u0119\u017Cyce"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093509
    m_Localized: "+1 ksi\u0119\u017Cyc i +50% obra\u017Ce\u0144 ksi\u0119\u017Cyc\xF3w. Jeste\u015B o 5% wolniejszy."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093510
    m_Localized: Ablacyjna skorupa
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093511
    m_Localized: "Prze\u017Cyj jedno \u015Bmiertelne trafienie z 30% masy."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093512
    m_Localized: "\u017Bagiel s\u0142oneczny"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093513
    m_Localized: "Jeste\u015B o 12% szybszy. Jedzenie daje o 10% mniej."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093514
    m_Localized: Studnia grawitacyjna
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093515
    m_Localized: "Strefa grawitacji szersza o 40%. Jeste\u015B o 6% wolniejszy."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093516
    m_Localized: "Mg\u0142awicowa zas\u0142ona"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093517
    m_Localized: Po turbo znikasz z minimap rywali na 10 s.
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093518
    m_Localized: "Je\u017Adziec komet"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093519
    m_Localized: "Komety lecz\u0105 ci\u0119 zamiast rani\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093520
    m_Localized: "Drapie\u017Cnik"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093521
    m_Localized: "Zab\xF3jstwa daj\u0105 o 20% wi\u0119cej masy. Jedzenie daje o 10% mniej."
    m_Metadata:
      m_Items: []
