  m_TableData:
  - m_Id: 3513516032
    m_Localized: Takma ad gir
    m_Metadata:
      m_Items: []
  - m_Id: 3647733760
    m_Localized: Rastgele
    m_Metadata:
      m_Items: []
  - m_Id: 3656122368
    m_Localized: Botlarla oyna
    m_Metadata:
      m_Items: []
  - m_Id: 3656122369
    m_Localized: "Oda olu\u015Ftur"
    m_Metadata:
      m_Items: []
  - m_Id: 3656122370
    m_Localized: "Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 3656122371
    m_Localized: Oda kodu
    m_Metadata:
      m_Items: []
  - m_Id: 3656122372
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 3656122373
    m_Localized: 'En iyi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 3656122374
    m_Localized: "\xC7evrimi\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 3656122375
    m_Localized: Renk
    m_Metadata:
      m_Items: []
  - m_Id: 3660316672
    m_Localized: "Oynamaya haz\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316673
    m_Localized: "Oda olu\u015Fturuluyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316674
    m_Localized: "Oda olu\u015Fturuldu. Kod: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316675
    m_Localized: "{0} odas\u0131na ba\u011Flan\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316676
    m_Localized: "Oyun ba\u015Flat\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316677
    m_Localized: "Y\xFCkleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316678
    m_Localized: "\xC7\u0131k\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316679
    m_Localized: "Ba\u011Flant\u0131 ba\u015Far\u0131s\u0131z. Oda kodunu ve internetini kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316680
    m_Localized: Bir oda kodu gir
    m_Metadata:
      m_Items: []
  - m_Id: 3660316681
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 3660316682
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316683
    m_Localized: Ses efektleri
    m_Metadata:
      m_Items: []
  - m_Id: 3660316684
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 3660316685
    m_Localized: "Reklam gizlili\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316686
    m_Localized: Kapat
    m_Metadata:
      m_Items: []
  - m_Id: 3660316687
    m_Localized: Tek oyuncu
    m_Metadata:
      m_Items: []
  - m_Id: 3660316688
    m_Localized: Oda {0}
    m_Metadata:
      m_Items: []
  - m_Id: 3660316689
    m_Localized: 'Oyuncular: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 3660316690
    m_Localized: "S\u0131ra: #{0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316691
    m_Localized: Liderler
    m_Metadata:
      m_Items: []
  - m_Id: 3660316692
    m_Localized: "Y\xF6nlendirmek i\xE7in s\xFCr\xFCkle \u2022 H\u0131zlanmak i\xE7in d\xFC\u011Fmeyi bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316693
    m_Localized: "Fare veya WASD ile y\xF6nlendir \u2022 H\u0131zlanmak i\xE7in Bo\u015Fluk tu\u015Funu bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316694
    m_Localized: '{0} oyuncusunu yedin'
    m_Metadata:
      m_Items: []
  - m_Id: 3660316695
    m_Localized: Kaybettin
    m_Metadata:
      m_Items: []
  - m_Id: 3664510976
    m_Localized: 'Skor {0}

      En iyi {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 3664510977
    m_Localized: Tekrar oyna
    m_Metadata:
      m_Items: []
  - m_Id: 3664510978
    m_Localized: Devam et (reklam)
    m_Metadata:
      m_Items: []
  - m_Id: 3664510979
    m_Localized: "Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510980
    m_Localized: "H\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510981
    m_Localized: "\xC7\u0131kmak i\xE7in tekrar geri tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 3714642083840
    m_Localized: "Titre\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 8989990191104
    m_Localized: "Oda sahibi oyundan ayr\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385408
    m_Localized: Oda dolu
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: "Bu odaya kat\u0131lmak i\xE7in oyunu g\xFCncelle"
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: '{0}, {1} oyuncusunu yedi'
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: "B\xFCy\xFCmek i\xE7in parlayan yemleri ye"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "K\xFC\xE7\xFCk gezegenleri ye, b\xFCy\xFCklerden ka\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "H\u0131z k\xFCtle harcar \u2014 ka\xE7mak ya da avlanmak i\xE7in kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 76559036448768
    m_Localized: "H\u0131zl\u0131 oyun"
    m_Metadata:
      m_Items: []
  - m_Id: 76559170666496
    m_Localized: "Ma\xE7 aran\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 78881082834944
    m_Localized: Gezegen
    m_Metadata:
      m_Items: []
  - m_Id: 78881208664064
    m_Localized: Reklam
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
