  m_TableData:
  - m_Id: 3513516032
    m_Localized: Takma ad gir
    m_Metadata:
      m_Items: []
  - m_Id: 3647733760
    m_Localized: Rastgele
    m_Metadata:
      m_Items: []
  - m_Id: 3656122368
    m_Localized: Botlarla oyna
    m_Metadata:
      m_Items: []
  - m_Id: 3656122369
    m_Localized: "Oda olu\u015Ftur"
    m_Metadata:
      m_Items: []
  - m_Id: 3656122370
    m_Localized: "Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 3656122371
    m_Localized: Oda kodu
    m_Metadata:
      m_Items: []
  - m_Id: 3656122372
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 3656122373
    m_Localized: 'En iyi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 3656122374
    m_Localized: "\xC7evrimi\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 3656122375
    m_Localized: Renk
    m_Metadata:
      m_Items: []
  - m_Id: 3660316672
    m_Localized: "Oynamaya haz\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316673
    m_Localized: "Oda olu\u015Fturuluyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316674
    m_Localized: "Oda olu\u015Fturuldu. Kod: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316675
    m_Localized: "{0} odas\u0131na ba\u011Flan\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316676
    m_Localized: "Oyun ba\u015Flat\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316677
    m_Localized: "Y\xFCkleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316678
    m_Localized: "\xC7\u0131k\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316679
    m_Localized: "Ba\u011Flant\u0131 ba\u015Far\u0131s\u0131z. Oda kodunu ve internetini kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 3660316680
    m_Localized: Bir oda kodu gir
    m_Metadata:
      m_Items: []
  - m_Id: 3660316681
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 3660316682
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316683
    m_Localized: Ses efektleri
    m_Metadata:
      m_Items: []
  - m_Id: 3660316684
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 3660316685
    m_Localized: "Reklam gizlili\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316686
    m_Localized: Kapat
    m_Metadata:
      m_Items: []
  - m_Id: 3660316687
    m_Localized: Tek oyuncu
    m_Metadata:
      m_Items: []
  - m_Id: 3660316688
    m_Localized: Oda {0}
    m_Metadata:
      m_Items: []
  - m_Id: 3660316689
    m_Localized: 'Oyuncular: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 3660316690
    m_Localized: "S\u0131ra: #{0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316691
    m_Localized: Liderler
    m_Metadata:
      m_Items: []
  - m_Id: 3660316692
    m_Localized: "Y\xF6nlendirmek i\xE7in s\xFCr\xFCkle \u2022 H\u0131zlanmak i\xE7in d\xFC\u011Fmeyi bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316693
    m_Localized: "Fare veya WASD ile y\xF6nlendir \u2022 H\u0131zlanmak i\xE7in Bo\u015Fluk tu\u015Funu bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 3660316694
    m_Localized: '{0} oyuncusunu yedin'
    m_Metadata:
      m_Items: []
  - m_Id: 3660316695
    m_Localized: Kaybettin
    m_Metadata:
      m_Items: []
  - m_Id: 3664510976
    m_Localized: 'Skor {0}

      En iyi {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 3664510977
    m_Localized: Tekrar oyna
    m_Metadata:
      m_Items: []
  - m_Id: 3664510978
    m_Localized: Devam et (reklam)
    m_Metadata:
      m_Items: []
  - m_Id: 3664510979
    m_Localized: "Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510980
    m_Localized: "H\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 3664510981
    m_Localized: "\xC7\u0131kmak i\xE7in tekrar geri tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 3714642083840
    m_Localized: "Titre\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 8989990191104
    m_Localized: "Oda sahibi oyundan ayr\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385408
    m_Localized: Oda dolu
    m_Metadata:
      m_Items: []
  - m_Id: 8989994385409
    m_Localized: "Bu odaya kat\u0131lmak i\xE7in oyunu g\xFCncelle"
    m_Metadata:
      m_Items: []
  - m_Id: 67018165059584
    m_Localized: '{0}, {1} oyuncusunu yedi'
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083008
    m_Localized: "B\xFCy\xFCmek i\xE7in parlayan yemleri ye"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083009
    m_Localized: "K\xFC\xE7\xFCk gezegenleri ye, b\xFCy\xFCklerden ka\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 67018295083010
    m_Localized: "H\u0131z k\xFCtle harcar \u2014 ka\xE7mak ya da avlanmak i\xE7in kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 76559036448768
    m_Localized: "H\u0131zl\u0131 oyun"
    m_Metadata:
      m_Items: []
  - m_Id: 76559170666496
    m_Localized: "Ma\xE7 aran\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 78881082834944
    m_Localized: Gezegen
    m_Metadata:
      m_Items: []
  - m_Id: 78881208664064
    m_Localized: Reklam
    m_Metadata:
      m_Items: []
  - m_Id: 16379358955941888
    m_Localized: "Gizlilik politikas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 16380462645096448
    m_Localized: "Kuyruklu y\u0131ld\u0131z adlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 17755957282484224
    m_Localized: "Reklam kullan\u0131lam\u0131yor. Daha sonra tekrar deneyin."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241810624512
    m_Localized: "Bir yetenek se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093504
    m_Localized: "\u0130yon \u0130zi"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093505
    m_Localized: "Takviye h\u0131z\u0131 +%15. Hasar veren iz 2 sn kal\u0131r. Takviyenin k\xFCtle bedeli +%25."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093506
    m_Localized: Manyetosfer
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093507
    m_Localized: "M\u0131knat\u0131s +%50; h\u0131z -%8"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093508
    m_Localized: "A\u011F\u0131r Aylar"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093509
    m_Localized: "+1 ay; hasar +%50; h\u0131z -%5"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093510
    m_Localized: Ablatif Kabuk
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093511
    m_Localized: "Bir \xF6l\xFCmc\xFCl darbeyi darbe \xF6ncesi k\xFCtlenin %30\u2019uyla atlat. En az ba\u015Flang\u0131\xE7 k\xFCtlen kal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093512
    m_Localized: "G\xFCne\u015F Yelkeni"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093513
    m_Localized: "H\u0131z +%12; yiyecek -%10"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093514
    m_Localized: "K\xFCtle\xE7ekim Kuyusu"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093515
    m_Localized: "\xC7ekim alan\u0131 +%40; h\u0131z -%6"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093516
    m_Localized: Bulutsu Perdesi
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093517
    m_Localized: 'Turbo: haritada 10 sn gizlen; bekleme 40 sn'
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093518
    m_Localized: "Kuyruklu Y\u0131ld\u0131z S\xFCr\xFCc\xFCs\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093519
    m_Localized: "Kuyruklu y\u0131ld\u0131z \xE7arpmas\u0131 5 sn\u2019de bir normal hasar\u0131n %20\u2019si kadar iyile\u015Ftirir. \xC7arpma hasar\u0131 yok. Do\u011Fal yiyecek \u2212%10."
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093520
    m_Localized: "Y\u0131rt\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 17768241907093521
    m_Localized: "\xD6ld\xFCrme k\xFCtlesi +%20; yiyecek -%10"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034084401152
    m_Localized: "S\xFCre: {0}   Yenen: {1}   Kademe: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315712
    m_Localized: "{0} taraf\u0131ndan yenildin"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315713
    m_Localized: "R\xFCtbe {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315714
    m_Localized: "+{0} XP   +{1} y\u0131ld\u0131z tozu"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315715
    m_Localized: "Yeni r\xFCtbe!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315716
    m_Localized: "Y\u0131ld\u0131z tozu \xD72 (reklam)"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315717
    m_Localized: "R\xFCtbe {0}   Y\u0131ld\u0131z tozu {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315718
    m_Localized: "G\xF6revler"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315719
    m_Localized: "G\xFCnl\xFCk g\xF6revler"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315720
    m_Localized: "Seri: {0} g\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034147315721
    m_Localized: "G\xFCnl\xFCk bonus: +{0} y\u0131ld\u0131z tozu"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510016
    m_Localized: Al +{0}
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510017
    m_Localized: "De\u011Fi\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510018
    m_Localized: Tamam
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510019
    m_Localized: '{0} gezegen ye'
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510020
    m_Localized: "{0}. kademeye ula\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510021
    m_Localized: Tek oyunda {0} saniye hayatta kal
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510022
    m_Localized: "Tek oyunda {0} puana ula\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510023
    m_Localized: "{0} yetenek se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510024
    m_Localized: '{0} oyun oyna'
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510025
    m_Localized: Reklam / {0}
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510026
    m_Localized: "Gezegenini y\xF6nlendirmek i\xE7in parma\u011F\u0131n\u0131 s\xFCr\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510027
    m_Localized: "K\u0131rm\u0131z\u0131 halka: daha b\xFCy\xFCk gezegen. Ka\xE7!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510028
    m_Localized: "Ye\u015Fil halka: daha k\xFC\xE7\xFCk gezegen. Onu ye!"
    m_Metadata:
      m_Items: []
  - m_Id: 17778034151510029
    m_Localized: "Aylar ve ilk yetene\u011Fin i\xE7in b\xFCy\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441010253824
    m_Localized: "Meteor ya\u011Fmuru yakla\u015F\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448128
    m_Localized: "Meteor ya\u011Fmuru!"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448129
    m_Localized: "Bir y\u0131ld\u0131z uyan\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448130
    m_Localized: "Bir y\u0131ld\u0131z patlamak \xFCzere!"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448131
    m_Localized: "Kara delik olu\u015Fuyor"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448132
    m_Localized: Kara delik! Uzak dur
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448133
    m_Localized: "Bug\xFCn: d\xFC\u015F\xFCk yer\xE7ekimi"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448134
    m_Localized: "Bug\xFCn: y\xFCksek yer\xE7ekimi"
    m_Metadata:
      m_Items: []
  - m_Id: 17782441014448135
    m_Localized: "Bug\xFCn: alt\u0131na h\xFCcum, bol ganimet"
    m_Metadata:
      m_Items: []
  - m_Id: 17797599656923136
    m_Localized: "Joystick sa\u011Fda"
    m_Metadata:
      m_Items: []
  - m_Id: 18109183573741568
    m_Localized: Sabit joystick
    m_Metadata:
      m_Items: []
  - m_Id: 18134015178821632
    m_Localized: Zorluk
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541888
    m_Localized: "Botlar ve solo hasar\u0131; oda sahibi se\xE7er"
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541889
    m_Localized: Kolay
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541890
    m_Localized: Orta
    m_Metadata:
      m_Items: []
  - m_Id: 18134015237541891
    m_Localized: Zor
    m_Metadata:
      m_Items: []
  - m_Id: 18145445231841280
    m_Localized: "Ma\xE7a yeniden ba\u011Flan\u0131l\u0131yor\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 18266357037051904
    m_Localized: "Play Oyunlar'a giri\u015F yap"
    m_Metadata:
      m_Items: []
  - m_Id: 18266357120937984
    m_Localized: "S\u0131ralamalar"
    m_Metadata:
      m_Items: []
  - m_Id: 18266357120937985
    m_Localized: "Ba\u015Far\u0131mlar"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280072556544
    m_Localized: "Ku\u015Fan"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802752
    m_Localized: "Ku\u015Fan\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802753
    m_Localized: "{0} y\u0131ld\u0131z tozu"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802754
    m_Localized: "Reklam izle ve a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802755
    m_Localized: "Her g\xFCn {0} saatinde yenilenir"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802756
    m_Localized: "{0}/{1} \xB7 +{2} y\u0131ld\u0131z tozu"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802757
    m_Localized: "Otomatik se\xE7im"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802758
    m_Localized: "Kuyruklu y\u0131ld\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802759
    m_Localized: Ay darbesi
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802760
    m_Localized: "Arena s\u0131n\u0131r\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802761
    m_Localized: "\u0130yon izi"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802762
    m_Localized: Kara delik
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802763
    m_Localized: "E\u011Fitimi atla"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802764
    m_Localized: "K\xFC\xE7\xFCk gezegenleri ye. B\xFCy\xFCk gezegenlerden ve uydular\u0131ndan uzak dur."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802765
    m_Localized: "Kuyruklu y\u0131ld\u0131zlar h\u0131zl\u0131d\u0131r. \xC7arp\u0131\u015Fma k\xFCtle kaybettirir. Etraf\u0131ndan dola\u015F ya da yiyecek i\xE7in izini takip et."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802766
    m_Localized: "Kara delik gezegenleri \xE7eker. \xC7ekirde\u011Fi k\xFCtle kaybettirir. Halkan\u0131n d\u0131\u015F\u0131nda kal."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802767
    m_Localized: "Gezegenin evrim ge\xE7irdi. Y\xF6r\xFCngendeki uydular rakiplere vurabilir. Bu tur i\xE7in bir yetenek se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802768
    m_Localized: "R\xFCtbe atlad\u0131n. Turlar XP kazand\u0131r\u0131r ve her yeni r\xFCtbe y\u0131ld\u0131z tozu verir. Profilinde gezegen almak i\xE7in harca."
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802769
    m_Localized: "Ye\u015Fil"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802770
    m_Localized: Mor
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802771
    m_Localized: "G\xFCne\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802772
    m_Localized: "\u015Eeker"
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802773
    m_Localized: Kalp
    m_Metadata:
      m_Items: []
  - m_Id: 21402280185802774
    m_Localized: Kristal
    m_Metadata:
