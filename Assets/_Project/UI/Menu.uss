.menu-bg {
    background-image: url("/Assets/_Project/Sprites/Backgrounds/MainBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

#header {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    align-items: center;
}

#game-title {
    font-size: 92px;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgba(10, 4, 30, 0.9);
    margin: 0;
    padding: 0;
}

#best-score {
    font-size: 34px;
    color: var(--gold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(21, 10, 51);
    text-shadow: 0 3px 0 rgba(21, 10, 51, 0.8);
    margin: 0;
    padding: 0;
}

#settings-button {
    position: absolute;
    top: 24px;
    right: 32px;
}

#columns {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    margin-top: 190px;
    margin-bottom: 100px;
}

.menu--portrait #columns {
    flex-direction: column;
    margin-top: 220px;
    margin-bottom: 150px;
}

.menu-item {
    margin: 12px 0;
}

.profile-chip {
    flex-direction: row;
    align-items: center;
    width: 520px;
    height: 116px;
    padding: 0 28px 0 16px;
    border-radius: 58px;
    border-width: 2px;
    border-color: var(--outline);
    background-color: var(--panel);
    transition-property: scale;
    transition-duration: 0.08s;
}

.profile-chip:hover {
    background-color: var(--panel);
}

.profile-chip:active {
    scale: 0.96 0.96;
    background-color: var(--panel);
}

#profile-skin {
    width: 88px;
    height: 88px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

#profile-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 42px;
    color: white;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    overflow: hidden;
    margin: 0;
    padding: 0;
}

.overlay {
    display: none;
    justify-content: center;
    align-items: center;
}

.overlay-backdrop {
    background-color: rgba(8, 3, 22, 0.78);
}

.overlay-card {
    width: 820px;
    max-width: 96%;
    max-height: 92%;
    min-height: 0;
    flex-shrink: 1;
    padding: 30px 36px;
    align-items: stretch;
    background-color: var(--panel-modal);
    border-radius: 40px;
}

.overlay-section {
    margin: 18px 0 8px 0;
}

.overlay-item {
    align-self: center;
    margin: 8px 0;
}

.overlay-close {
    align-self: center;
    margin-top: 12px;
}

.overlay-status {
    min-height: 40px;
    margin: 10px 0 0 0;
    padding: 0;
    font-size: 30px;
    color: rgb(226, 242, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}

.overlay-status.status--error {
    color: rgb(255, 150, 150);
}

.row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
}

.grow {
    flex-grow: 1;
    margin-right: 20px;
}

.join-row {
    margin-top: 6px;
}

.skins {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    min-height: 210px;
    flex-shrink: 0;
}

.skin {
    width: 88px;
    height: 88px;
    margin: 5px 6px;
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 44px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.skin--selected {
    scale: 1.12 1.12;
    border-width: 3px;
    border-color: var(--gold);
}

.skin--locked {
    -unity-background-image-tint-color: rgb(115, 115, 140);
}

.skin__badge {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: -2px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(14, 74, 178);
    border-width: 2px;
    border-color: rgb(21, 10, 51);
    font-size: 17px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

#status-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 36px;
    font-size: 32px;
    color: rgb(226, 242, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(21, 10, 51);
    text-shadow: 0 3px 0 rgba(21, 10, 51, 0.8);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-left: 24px;
    margin-right: 24px;
}

#status-text.status--error {
    color: rgb(255, 150, 150);
}

#version-text {
    position: absolute;
    right: 24px;
    bottom: 8px;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: lower-right;
    margin: 0;
    padding: 0;
}

#rank-dust {
    font-size: 32px;
    color: white;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(21, 10, 51);
    text-shadow: 0 3px 0 rgba(21, 10, 51, 0.8);
    margin: 0;
    padding: 0;
}

#missions-button {
    position: absolute;
    top: 24px;
    left: 32px;
}

#menu-leaderboards-button {
    display: none;
    position: absolute;
    top: 24px;
    left: 140px;
}

#menu-achievements-button {
    display: none;
    position: absolute;
    top: 24px;
    right: 140px;
}

#missions-overlay {
    display: none;
    justify-content: center;
    align-items: center;
}

#missions-backdrop {
    background-color: rgba(8, 3, 22, 0.78);
}

#missions-card {
    width: 900px;
    max-width: 96%;
    max-height: 92%;
    min-height: 0;
    flex-shrink: 1;
    padding: 30px 36px 30px 36px;
    align-items: stretch;
    background-color: var(--panel-modal);
    border-radius: 40px;
}

#missions-title {
    white-space: normal;
    font-size: 54px;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgba(10, 4, 30, 0.9);
    margin: 0 0 6px 0;
    padding: 0;
}

#missions-streak {
    white-space: normal;
    font-size: 30px;
    color: var(--gold);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

#missions-bonus {
    white-space: normal;
    font-size: 28px;
    color: rgb(153, 255, 128);
    -unity-text-align: middle-center;
    margin: 0 0 8px 0;
    padding: 0;
}

#mission-list {
    margin: 12px 0 18px 0;
}

.mission-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    padding: 8px 12px;
    border-radius: 24px;
    background-color: rgba(21, 10, 51, 0.7);
}

.mission-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
}

.mission-name {
    font-size: 30px;
    color: white;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.mission-progress {
    font-size: 26px;
    color: rgb(200, 190, 230);
    margin: 4px 0 0 0;
    padding: 0;
}

.mission-row .btn-small {
    width: 196px;
    margin-left: 8px;
}

#missions-close {
    align-self: center;
}

#blitz-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

#blitz-label {
    font-size: 28px;
    color: white;
    margin: 0 0 0 14px;
    padding: 0;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(21, 10, 51);
}
