#border-warning {
    background-image: url("/Assets/_Project/Sprites/UI/EdgeVignette.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 38, 51);
    opacity: 0;
}

#score-text, #session-text, #kill-feed, #hint-text, #score-popup {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(21, 10, 51);
    text-shadow: 0 3px 0 rgba(21, 10, 51, 0.8);
}

#score-text {
    position: absolute;
    left: 40px;
    top: 28px;
    font-size: 86px;
    color: white;
    margin: 0;
    padding: 0;
}

#session-text {
    position: absolute;
    left: 40px;
    top: 138px;
    width: 560px;
    font-size: 30px;
    color: white;
    white-space: normal;
    margin: 0;
    padding: 0;
}

#minimap {
    position: absolute;
    left: 40px;
    top: 300px;
    width: 180px;
    height: 180px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(191, 153, 255, 0.55);
    background-color: rgba(21, 10, 51, 0.8);
}

.minimap-blip {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 5px;
}

#top-buttons {
    position: absolute;
    right: 30px;
    top: 24px;
    flex-direction: row;
}

#top-buttons .btn {
    margin-left: 12px;
}

#leaderboard-panel {
    position: absolute;
    right: 30px;
    top: 130px;
    width: 430px;
    min-height: 330px;
    padding: 14px 22px;
    background-color: rgba(21, 10, 51, 0.82);
}

#leaderboard-text {
    font-size: 30px;
    color: white;
    white-space: normal;
    margin: 0;
    padding: 0;
}

#kill-feed {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    font-size: 36px;
    color: rgb(255, 230, 115);
    -unity-text-align: middle-center;
    opacity: 0;
}

#hint-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 300px;
    font-size: 36px;
    color: white;
    -unity-text-align: middle-center;
    opacity: 0;
}

#score-popup {
    position: absolute;
    width: 320px;
    margin-left: -160px;
    font-size: 48px;
    color: rgb(153, 255, 128);
    -unity-text-align: middle-center;
    opacity: 0;
}

.control {
    position: absolute;
    bottom: 70px;
    width: 200px;
    height: 200px;
    border-radius: 100px;
    border-width: 5px;
    border-color: rgba(205, 170, 255, 0.8);
    background-color: rgba(41, 20, 82, 0.55);
    scale: 0.78 0.78;
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

#stick {
    left: 180px;
}

#boost-button {
    right: 180px;
}

#stick-knob {
    width: 104px;
    height: 104px;
    border-radius: 52px;
    background-color: rgba(191, 153, 255, 0.22);
    background-image: url("/Assets/_Project/Sprites/Buttons/StickRing.png");
    -unity-background-scale-mode: scale-to-fit;
}

#boost-icon {
    rotate: 180deg;
    width: 104px;
    height: 104px;
    background-image: url("/Assets/_Project/Sprites/Buttons/BoostTriangle.png");
    -unity-background-scale-mode: scale-to-fit;
}

#boost-button:active {
    scale: 0.72 0.72;
    background-color: rgba(120, 70, 220, 0.6);
}

#defeat-panel {
    display: none;
    background-color: rgba(8, 3, 22, 0.72);
    justify-content: center;
    align-items: center;
}

#defeat-card {
    width: 720px;
    max-width: 94%;
    padding: 36px 40px 40px 40px;
    align-items: center;
    background-color: rgba(41, 20, 82, 0.96);
}

#defeat-title {
    font-size: 68px;
    color: var(--danger);
    margin: 0 0 12px 0;
}

#defeat-body {
    font-size: 40px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 22px 0;
}

#continue-button {
    margin-top: 14px;
}

#defeat-leave {
    margin-top: 20px;
}

#loading-overlay {
    display: none;
    background-color: rgb(21, 10, 51);
    justify-content: center;
    align-items: center;
}

#loading-title {
    font-size: 48px;
    color: white;
}
