:root {
    --panel: rgba(41, 20, 82, 0.88);
    --panel-modal: rgba(41, 20, 82, 0.96);
    --outline: rgba(191, 153, 255, 0.28);
    --field: rgba(23, 11, 51, 0.95);
    --muted: rgb(222, 238, 255);
    --gold: rgb(255, 199, 51);
    --danger: rgb(255, 140, 140);
    -unity-font: url("/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
    -unity-font-style: bold;
    color: white;
    font-size: 34px;
}

.lang-zh {
    -unity-font: url("/Assets/_Project/Art/Fonts/ZCOOLKuaiLe-Regular.ttf");
}

.lang-ja {
    -unity-font: url("/Assets/_Project/Art/Fonts/ZenMaruGothic-Bold.ttf");
}

.lang-ko {
    -unity-font: url("/Assets/_Project/Art/Fonts/NanumGothic-Bold.ttf");
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.safe {
    flex-grow: 1;
}

.safe-modal {
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

.card {
    background-color: var(--panel);
    border-radius: 32px;
    border-width: 2px;
    border-color: var(--outline);
    padding: 34px;
}

.section-label {
    white-space: normal;
    min-width: 0;
    color: var(--muted);
    font-size: 34px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.btn {
    margin: 0;
    padding: 12px 28px 22px 28px;
    max-width: 100%;
    flex-shrink: 0;
    white-space: normal;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(21, 10, 51);
    text-shadow: 0 3px 0 rgba(21, 10, 51, 0.55);
    transition-property: scale, opacity;
    transition-duration: 0.08s;
}

.btn-yellow {
    -unity-text-outline-color: rgb(140, 66, 0);
    text-shadow: 0 3px 0 rgba(140, 66, 0, 0.7);
}

.btn-green {
    -unity-text-outline-color: rgb(28, 92, 10);
    text-shadow: 0 3px 0 rgba(28, 92, 10, 0.7);
}

.btn-blue {
    -unity-text-outline-color: rgb(6, 52, 140);
    text-shadow: 0 3px 0 rgba(6, 52, 140, 0.7);
}

.btn-red {
    -unity-text-outline-color: rgb(118, 12, 52);
    text-shadow: 0 3px 0 rgba(118, 12, 52, 0.7);
}

.btn:hover {
    background-color: rgba(0, 0, 0, 0);
}

.btn:active {
    scale: 0.94 0.94;
    background-color: rgba(0, 0, 0, 0);
}

.btn:disabled {
    opacity: 0.5;
}

.btn-long {
    width: 400px;
    height: 108px;
    font-size: 40px;
    -unity-text-auto-size: best-fit 20px 40px;
}

.btn-cta {
    width: 460px;
    height: 124px;
    font-size: 46px;
    -unity-text-auto-size: best-fit 24px 46px;
}

.btn-small {
    width: 228px;
    height: 110px;
    font-size: 30px;
    -unity-text-auto-size: best-fit 18px 30px;
    -unity-text-outline-width: 2px;
}

.btn-hud {
    width: 214px;
    height: 104px;
    font-size: 30px;
    -unity-text-auto-size: best-fit 18px 30px;
    -unity-text-outline-width: 2px;
}

.btn-icon {
    width: 104px;
    height: 104px;
    padding: 0 0 8px 0;
    overflow: visible;
    align-items: center;
    justify-content: center;
    -unity-slice-left: 60;
    -unity-slice-right: 60;
    -unity-slice-top: 55;
    -unity-slice-bottom: 70;
    -unity-slice-scale: 0.62px;
}

.btn-glyph {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.glyph-settings {
    background-image: url("/Assets/_Project/Sprites/Buttons/IconSettings.png");
}

.glyph-home {
    background-image: url("/Assets/_Project/Sprites/Buttons/IconHome.png");
}

.glyph-missions {
    background-image: url("/Assets/_Project/Sprites/Buttons/IconMissions.png");
}

.glyph-trophy {
    background-image: url("/Assets/_Project/Sprites/Buttons/IconTrophy.png");
}

.glyph-medal {
    background-image: url("/Assets/_Project/Sprites/Buttons/IconMedal.png");
}

.btn-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 38px;
    height: 38px;
    margin: 0;
    padding: 0;
    border-radius: 19px;
    border-width: 3px;
    border-color: white;
    background-color: rgb(255, 64, 90);
    font-size: 26px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    display: none;
}

.btn-yellow.btn-cta, .btn-yellow.btn-long {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/15Button_Long_Yellow.png");
}

.btn-green.btn-cta, .btn-green.btn-long {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/13Button_Long_Green.png");
}

.btn-blue.btn-cta, .btn-blue.btn-long {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/12Button_Long_Blue.png");
}

.btn-red.btn-cta, .btn-red.btn-long {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/14Button_Long_Red.png");
}

.btn-yellow.btn-small, .btn-yellow.btn-hud {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/10Button_Midl_Yellow.png");
}

.btn-green.btn-small, .btn-green.btn-hud {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/9Button_Midl_Green.png");
}

.btn-blue.btn-small, .btn-blue.btn-hud {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/11Button_Midl_Blue.png");
}

.btn-red.btn-small, .btn-red.btn-hud {
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/8Button_Midl_Red.png");
}

.field {
    margin: 0;
    min-width: 0;
    flex-shrink: 1;
    height: 92px;
}

.field > .unity-base-text-field__input {
    height: 100%;
    margin: 0;
    background-color: var(--field);
    border-radius: 30px;
    border-width: 2px;
    border-color: var(--outline);
    color: white;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 20px;
}

.field > .unity-base-text-field__input:focus {
    border-color: var(--gold);
}

.unity-base-text-field__input--placeholder,
.field .unity-base-text-field__input--placeholder {
    color: rgba(255, 255, 255, 0.62);
    font-size: 34px;
}
