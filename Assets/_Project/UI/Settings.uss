#settings-overlay {
    display: none;
    justify-content: center;
    align-items: center;
}

#settings-backdrop {
    background-color: rgba(8, 3, 22, 0.78);
}

.settings-panel {
    width: 940px;
    max-width: 94%;
    max-height: 96%;
    min-height: 0;
    flex-shrink: 1;
    padding: 24px 48px 20px 48px;
    background-color: var(--panel-modal);
    border-radius: 40px;
    align-items: stretch;
}

#settings-title {
    font-size: 52px;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgba(10, 4, 30, 0.9);
    margin: 0;
    padding: 0;
}

.settings-divider {
    align-self: center;
    width: 140px;
    height: 6px;
    margin: 10px 0 18px 0;
    border-radius: 3px;
    background-color: var(--gold);
}

.settings-list {
    align-self: stretch;
    flex-shrink: 1;
    min-height: 0;
}

.settings-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    align-self: stretch;
    min-height: 72px;
    margin-bottom: 8px;
    padding: 4px 30px;
    border-radius: 28px;
    border-width: 2px;
    border-color: rgba(191, 153, 255, 0.16);
    background-color: rgba(255, 255, 255, 0.06);
}

.settings-row--last {
    margin-bottom: 0;
}

.settings-label {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 220px;
    min-width: 0;
    white-space: normal;
    font-size: 32px;
    color: white;
    -unity-text-align: middle-left;
    margin: 0 20px 0 0;
    padding: 0;
}

.settings-control {
    width: 360px;
    max-width: 100%;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
}

.settings-control--end {
    justify-content: flex-end;
}

.settings-control--toggle {
    width: 112px;
}

.settings-slider {
    flex-grow: 1;
    margin: 0;
}

.settings-slider .unity-base-slider__drag-container {
    height: 72px;
}

.settings-slider .unity-base-slider__tracker {
    height: 16px;
    top: 28px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.34);
}

.settings-slider .unity-base-slider__dragger {
    width: 52px;
    height: 52px;
    top: 10px;
    margin: 0 0 0 -26px;
    border-width: 5px;
    border-color: var(--gold);
    border-radius: 26px;
    background-color: white;
}

.slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 8px;
    background-color: var(--gold);
}

.settings-toggle {
    margin: 0;
    width: 112px;
    height: 88px;
}

.settings-toggle .unity-toggle__input {
    width: 112px;
    height: 88px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.settings-toggle .unity-toggle__checkmark {
    width: 112px;
    height: 60px;
    margin: 0;
    border-radius: 30px;
    border-width: 2px;
    border-color: var(--outline);
    background-color: var(--field);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.settings-toggle:checked .unity-toggle__checkmark {
    border-color: var(--gold);
    background-color: var(--gold);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

.toggle-knob {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(196, 184, 224);
    transition-property: left, background-color;
    transition-duration: 0.12s;
}

.settings-toggle:checked .toggle-knob {
    left: 56px;
    background-color: white;
}

.language-stepper {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stepper-button {
    width: 100px;
    height: 96px;
    font-size: 40px;
    padding: 0 8px 8px 8px;
    background-image: url("/Assets/_Project/Art/UI/Buttons/PNG/11Button_Midl_Blue.png");
}

#language-value,
#difficulty-value {
    font-size: 34px;
    color: white;
    -unity-text-align: middle-center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    margin: 0 8px;
    padding: 0;
}

.settings-footer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    align-self: stretch;
    margin-top: 18px;
}

.settings-footer > .btn {
    margin: 6px 12px;
}

.settings-services {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: stretch;
    margin-top: 14px;
}

.settings-services > .btn {
    margin: 6px 8px;
}

.link {
    min-height: 80px;    align-self: stretch;
    margin: 8px 0 0 0;
    padding: 4px 16px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 30px;
    color: rgb(170, 220, 255);
    -unity-text-align: middle-center;
    max-width: 100%;
    white-space: normal;
    flex-shrink: 0;
}

.link:hover {
    background-color: rgba(0, 0, 0, 0);
    color: white;
}

.link:active {
    background-color: rgba(0, 0, 0, 0);
    color: var(--gold);
}

.difficulty-heading {
    justify-content: center;
}

.difficulty-heading > Label {
    white-space: normal;
}

.difficulty-hint {
    font-size: 24px;
    color: rgb(196, 184, 224);
    white-space: normal;
}

#difficulty-value {
    font-size: 30px;
    white-space: normal;
}